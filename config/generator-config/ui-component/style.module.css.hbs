/** 
 * ---
 * Remove this file if we don't have styles for the component 
 * This is starter styling. Keep what helps, delete what doesn’t. 
 * ---
 **/
 
.base {
  background-color: var(--background-color-box);
  border: var(--border-width) solid var(--border-color-card);
  border-radius: var(--border-radius-large);
  box-shadow: var(--box-shadow-card);
  container-type: inline-size;
  padding: var(--space-medium);

  &:hover {
    box-shadow: var(--box-shadow-card-hover);
  }

{{#if includeState}}
  .items {
    display: block;
  }

  .summary {
    font-size: var(--font-size-large);
    margin-bottom: var(--space-small);
  }

  .list {
    list-style: none;
    margin: 0 0 var(--space-medium) 0;
    padding: 0;

    .listItem {
      align-items: center;
      display: flex;
      gap: var(--space-small);
      justify-content: space-between;
      padding: var(--space-xsmall) 0;
    }
  }

  .empty {
    color: var(--text-color-muted);
    margin-bottom: var(--space-medium);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-small);

    button {
      appearance: none;
      background-color: var(--button-background-color);
      border: var(--button-border);
      border-radius: var(--border-radius-medium);
      color: var(--button-text-color);
      cursor: pointer;
      padding: var(--space-small);
      width: auto;

      &:hover {
        background-color: var(--button-background-color-hover);
      }

      &:focus-visible {
        background-color: var(--button-background-color-selected);
      }

      &:active {
        background-color: var(--button-background-color-active);
      }
    }
  }
{{/if}}
}