import style from "./style.module.css"

{{#if includeState}}
import { derive{{pascalCase stateName}}View, use{{pascalCase stateName}} } from "@data/state/{{stateName}}"
{{/if}}

/**
 * {{pascalCase componentName}}
 * ---
 * Describe what this component does.
 *
 * Notes:
 * - Local UI state lives in React (interactions, controlled inputs, etc.)
{{#if includeState}}
 * - Synced state lives in @data/state/{{stateName}}
{{/if}}
 */
export function {{pascalCase componentName}}() {
{{#if includeState}}
  // Grab what we need from the store (small + explicit selectors)
  const items = use{{pascalCase stateName}}((s) => s.data.items)

  const addItem = use{{pascalCase stateName}}((s) => s.actions.addItem)
  const removeItem = use{{pascalCase stateName}}((s) => s.actions.removeItem)
  const reset = use{{pascalCase stateName}}((s) => s.actions.reset)

  const handleAddExample = () => addItem("example")
  const handleRemoveFirst = () => removeItem(0)
  const handleReset = () => reset()

  const { totalItems, isEmpty } = derive{{pascalCase stateName}}View({ items })
{{/if}}

  return (
    <div className={style.base} data-testid="{{kebabCase componentName}}">
      <h2>{{pascalCase componentName}}</h2>
      <p>This is scaffolding — keep what helps, delete what doesn’t.</p>

{{#if includeState}}
      <div className={style.items}>
        <div className={style.summary}>
          <strong>Total:</strong> {totalItems}
        </div>

        {!isEmpty ? (
          <ul className={style.list}>
            {items.map((item, index) => (
              <li key={`${item}-${index}`} className={style.listItem}>
                <span>{item}</span>
                <button type="button" onClick={() => removeItem(index)}>
                  Remove
                </button>
              </li>
            ))}
          </ul>
        ) : (
          <div className={style.empty}>No items left. Add a new one.</div>
        )}

        <div className={style.actions}>
          <button type="button" onClick={handleAddExample}>
            Add "example"
          </button>

          <button type="button" onClick={handleRemoveFirst} disabled={isEmpty}>
            Remove first
          </button>

          <button type="button" onClick={handleReset}>
            Reset
          </button>
        </div>
      </div>
{{/if}}
    </div>
  )
}