import style from "./style.module.css"

{{#if includeState}}
import { derive{{pascalCase stateName}}View, use{{pascalCase stateName}} } from "@data/state/{{stateName}}"
{{/if}}

/**
 * {{pascalCase componentName}}
 * ---
 * Describe what this component does.
 *
 * Notes:
 * - Local UI state lives in React (interactions, controlled inputs, etc.)
{{#if includeState}}
 * - Shared state lives in @data/state/{{stateName}}
{{/if}}
 */
export function {{pascalCase componentName}}() {
{{#if includeState}}
  // Grab what we need from the store (small + explicit selectors)
  const snackName = use{{pascalCase stateName}}((s) => s.shared.data.snackName)
  const totalSnacks = use{{pascalCase stateName}}((s) => s.shared.data.totalSnacks)

  const eatSnack = use{{pascalCase stateName}}((s) => s.actions.eatSnack)
  const addSnack = use{{pascalCase stateName}}((s) => s.actions.addSnack)
  const resetSnacks = use{{pascalCase stateName}}((s) => s.actions.resetSnacks)

  // If we are passing values to the function, define it here
  const handleAddSnack = () => addSnack(2)
  
  const { snackLabel, isOutOfSnacks } = derive{{pascalCase stateName}}View({
    snackName,
    totalSnacks,
  })
{{/if}}

  return (
    <div className={style.base} data-testid="{{kebabCase componentName}}">
    <h2>{{pascalCase componentName}}</h2>
    <p>This is scaffolding — keep what helps, delete what doesn’t.</p>

{{#if includeState}}
      <div className={style.snacks}>
        <div className={style.snackLabel}>{snackLabel}</div>

        <div className={style.actions}>
          <button type="button" onClick={eatSnack} disabled={isOutOfSnacks}>
            Eat snack
          </button>

          <button type="button" onClick={handleAddSnack}>
            Add 2 snacks
          </button>

          <button type="button" onClick={resetSnacks}>
            Reset
          </button>
        </div>
      </div>
{{/if}}
    </div>
  )
}