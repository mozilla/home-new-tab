import { createCrossTabStore } from "../_system"

import type { {{pascalCase stateName}}Actions, {{pascalCase stateName}}State } from "./types"

// Basic config to get our store setup.
const storageKey = "app:{{kebabCase stateName}}"
const schemaVersion = 1
const initialData: {{pascalCase stateName}}State = { snackName: "pickle", totalSnacks: 5 }

const STORE_CONFIG = { storageKey, schemaVersion, initialData }

/**
 * {{pascalCase stateName}} state domain
 * ---------------------------------------------------------
 * This starts life as a tiny snack counter starter.
 * Replace the snack stuff with your real feature whenever you're ready.
 *
 * Mental model:
 * - One shared state object (persisted + synced across tabs)
 * - UI-friendly values can be derived with small helpers (like `derive{{pascalCase stateName}}View`)
 */
export const {{camelCase stateName}} =
  createCrossTabStore<{{pascalCase stateName}}State, {{pascalCase stateName}}Actions>(
    STORE_CONFIG,
    ({ commitShared: commit }) => ({
      eatSnack() {
        return commit((s) => {
          if (s.totalSnacks <= 0) return s
          return { ...s, totalSnacks: s.totalSnacks - 1 }
        })
      },

      addSnack(amount = 1) {
        return commit((s) => {
          // Keep it friendly: ignore weird inputs instead of exploding.
          const isValid = Number.isFinite(amount)
          const add = isValid ? Math.max(0, Math.floor(amount)) : 0

          // If we are trying to add no snacks, just return the state.
          if (add === 0) return s

          // Otherwise, we return the state, with the total snacks updated.
          return { ...s, totalSnacks: s.totalSnacks + add }
        })
      },

      resetSnacks() {
        return commit(() => ({ ...initialData }))
      },
    }),
  )

/**
 * derive{{pascalCase stateName}}View
 * ---
 * Optional helper for UI code. Totally safe to delete.
 */
export function derive{{pascalCase stateName}}View(state: {{pascalCase stateName}}State) {
  // Grab our values
  const { totalSnacks, snackName } = state

  // Generate a readable label
  const snackLabel =
    totalSnacks === 1 ? `1 ${snackName}` : `${totalSnacks} ${snackName}`

  // Are we out of snacks?
  const isOutOfSnacks = totalSnacks <= 0

  return { snackLabel, isOutOfSnacks }
}

// What most devs need day-to-day:
export const use{{pascalCase stateName}} = {{camelCase stateName}}.useStore
export * from "./types"