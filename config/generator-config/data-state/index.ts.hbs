import { createSyncedStore } from "../_system"

import type { {{pascalCase stateName}}Actions, {{pascalCase stateName}}State } from "./types"
import type { SyncedStoreConfig } from "../_system/types"

// Starter defaults for shared data.
// Tip: When changing the data model, update ./types.ts first.
const DEFAULT_{{upperCase stateName}}_STATE: {{pascalCase stateName}}State = {
  items: ["example"],
}

const {{upperCase stateName}}_STORE_CONFIG: SyncedStoreConfig<{{pascalCase stateName}}State> = { 
  syncKey: "app:{{kebabCase stateName}}", 
  schemaVersion: 1,
  initialData:  DEFAULT_{{upperCase stateName}}_STATE,
  restore: "session",
  onVisible: "refresh",
}

/**
 * {{pascalCase stateName}} state domain
 * ---------------------------------------------------------
 * Welcome! This file is designed to be easy to remix.
 *
 * Mental model:
 * - `data` is the source of truth (persisted + synced across tabs)
 * - Actions update `data` via `commit`
 * - UI can derive presentation values with tiny helpers (see `derive…View`)
 *
 * Tip: Try adding a new field + action (e.g. `sortOrder`) just to get the feel.
 */
export const {{camelCase stateName}} = createSyncedStore<{{pascalCase stateName}}State, {{pascalCase stateName}}Actions>(
    {{upperCase stateName}}_STORE_CONFIG,
    ({ commit }) => ({
      addItem(item) {
        if (!item) return

        commit((state) => ({
          ...state,
          items: [...state.items, item],
        }))
      },

      removeItem(index) {
        commit((state) => {
          const isOutOfBounds = index < 0 || index >= state.items.length
          if (isOutOfBounds) return state

          return {
            ...state,
            items: state.items.filter((_, i) => i !== index),
          }
        })
      },

      reset() {
        commit(() => ({ ...DEFAULT_{{upperCase stateName}}_STATE }))
      },
    }),
  )

/**
 * derive{{pascalCase stateName}}Display
 * ---
 * Optional UI helper for presentation logic.
 */
export function derive{{pascalCase stateName}}Display(
  state: {{pascalCase stateName}}State,
) {
  const { items } = state

  const totalItems = items.length
  const isEmpty = totalItems === 0

  return { items, totalItems, isEmpty }
}

// Day-to-day hook most UI code wants:
export const use{{pascalCase stateName}} = {{camelCase stateName}}.useStore
export * from "./types"