import { createSyncedStore, type SyncedStoreConfig } from "../_system"
{{#if inlineTypes}}

/**
 * {{pascalCase stateName}} store shape
 * ---------------------------------------------------------
 */
type {{pascalCase stateName}}Data = {
  items: string[]
}

type {{pascalCase stateName}}Actions = {
  addItem: (item: string) => void
  removeItem: (index: number) => void
  reset: () => void
}
{{else}}

import type { {{pascalCase stateName}}Actions, {{pascalCase stateName}}Data } from "./types"
{{/if}}

/**
 * {{pascalCase stateName}} setup
 * ---------------------------------------------------------
 */
const DEFAULT_{{upperSnakeCase stateName}}_DATA: {{pascalCase stateName}}Data = {
  items: ["example"],
}

const {{upperSnakeCase stateName}}_STORE_CONFIG = {
  syncKey: "app:{{kebabCase stateName}}",
  schemaVersion: 1,
  initialData: DEFAULT_{{upperSnakeCase stateName}}_DATA,
  restore: "session",
  onVisible: "refresh",
} satisfies SyncedStoreConfig<{{pascalCase stateName}}Data>

/**
 * {{pascalCase stateName}} state domain
 * ---------------------------------------------------------
 * Welcome! This file is designed to be easy to remix.
 */
export const {{camelCase stateName}} = createSyncedStore<{
  data: {{pascalCase stateName}}Data,
  actions: {{pascalCase stateName}}Actions
}>({{upperSnakeCase stateName}}_STORE_CONFIG, ({ commit }) => ({
    addItem(item) {
      if (!item) return

      commit((state) => ({...state, items: [...state.items, item]}))
    },

    removeItem(index) {
      commit((state) => {
        const isOutOfBounds = index < 0 || index >= state.items.length
        if (isOutOfBounds) return state

        return {...state, items: state.items.filter((_, i) => i !== index) }
      })
    },

    reset() {
      commit(() => ({ ...DEFAULT_{{upperSnakeCase stateName}}_DATA }))
    },
  }),
)

{{#if addDeriver}}
/**
 * derive{{pascalCase stateName}}Display
 * ---
 * Example Optional UI helper for presentation logic.
 */
export function derive{{pascalCase stateName}}Display(
  data: {{pascalCase stateName}}Data,
) {
  const { items } = data

  const totalItems = items.length
  const isEmpty = totalItems === 0

  return { items, totalItems, isEmpty }
}

{{/if}}
/**
 * {{pascalCase stateName}} exports
 * ---------------------------------------------------------
 */
// Day-to-day hook most UI code wants:
export const use{{pascalCase stateName}} = {{camelCase stateName}}.use

/** TESTS/DEBUG ONLY: raw Zustand store (includes _internal). */
export const use{{pascalCase stateName}}Store = {{camelCase stateName}}.debug._unsafe_useStore
