export type {{pascalCase stateName}}State = {
  snackName: string   // What we're counting (feel free to rename/remove)
  totalSnacks: number // How many we have
}

export type {{pascalCase stateName}}Actions = {
  /**
   * eatSnack
   * ---
   * Eat one snack (silently no-ops if you're out).
   */
  eatSnack: () => void

  /**
   * addSnack
   * ---
   * Add snacks. Defaults to 1.
   * Friendly behavior: ignores weird inputs instead of throwing.
   */
