{
  "name": "@config/l10n-config",
  "version": "0.0.0",
  "dependencies": {
    "@fluent/syntax": "^0.19.0",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@config/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "tsdown": "^0.21.9",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build:tooling": "tsdown src/index.ts --format esm --dts --log-level warn",
    "clean": "rm -rf dist node_modules",
    "l10n:extract": "tsx src/extract.ts",
    "postinstall": "tsdown src/index.ts --format esm --dts --log-level warn",
    "test": "vitest run"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
