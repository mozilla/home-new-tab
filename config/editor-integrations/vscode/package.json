{
  "description": "Shows inline localized text for static data-l10n-id usage.",
  "name": "fluent-l10n-dev",
  "version": "1.0.0",
  "activationEvents": [
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "workspaceContains:**/component.ftl"
  ],
  "categories": [
    "Other"
  ],
  "icon": "media/lion.png",
  "contributes": {
      "commands": [
      {
        "command": "hnt.fluentL10n.toggleInlayHints",
        "title": "HNT Fluent L10n: Toggle Inlay Hints"
      }
    ],
    "configuration": {
      "title": "Toggle Fluent L10n Inlay",
      "properties": {
        "hnt.fluentL10n.inlayHints.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show localized preview in inlay hints for static data-l10n-id values."
        }
      }
    }
  },
  "dependencies": {
    "@config/l10n-config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "displayName": "Fluent DOM L10n",
  "engines": {
    "vscode": "^1.96.0"
  },
  "license": "MPL-2.0",
  "main": "./dist/extension.js",
  "private": true,
  "publisher": "local",
  "scripts": {
    "build": "node ./esbuild.mjs",
    "prepare:license": "node ./.scripts/copy-license.mjs",
    "package:vsix": "pnpm build && pnpm prepare:license && pnpm dlx @vscode/vsce@3.2.2 package --no-dependencies --allow-missing-repository --out fluent-l10n-dev.vsix",
    "watch": "node ./esbuild.mjs --watch"
  }
}
