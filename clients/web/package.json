{
  "name": "@clients/web",
  "version": "0.0.0",
  "dependencies": {
    "@data/state": "workspace:*",
    "@ui/components": "workspace:*",
    "@ui/styles": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@common/types": "workspace:*",
    "@config/eslint-config": "workspace:*",
    "@config/typescript-config": "workspace:*",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "postcss": "^8.5.6",
    "postcss-mixins": "^12.1.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1"
  },
  "postcss": {
    "plugins": {
      "postcss-mixins": {}
    }
  },
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "clean": "rm -rf dist & rm -rf node_modules",
    "dev": "vite --strictPort --port ${VITE_APP_PORT:-5176}",
    "lint": "eslint .",
    "test:e2e:full": "playwright test",
    "test:e2e:smoke": "playwright test smoke/",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test visual/ --update-snapshots"
  },
  "type": "module"
}
